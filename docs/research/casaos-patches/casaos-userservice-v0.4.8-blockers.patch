 func PostUserRegister(c *gin.Context) {
+	// Before the first administrator exists, registration is local-only.
+	if service.MyService.User().GetUserCount() == 0 && !requestIsLoopback(c) {
+		c.JSON(http.StatusForbidden, model.Result{Success: common_err.ERROR_AUTH_TOKEN, Message: "the first administrator must be registered from localhost"})
+		return
+	}
+
