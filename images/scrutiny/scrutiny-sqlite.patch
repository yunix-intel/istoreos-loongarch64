+package database
+
+import (
+	"context"
+	"testing"
+	"time"
+
+	"github.com/analogj/scrutiny/webapp/backend/pkg"
+	"github.com/analogj/scrutiny/webapp/backend/pkg/models"
+	"github.com/analogj/scrutiny/webapp/backend/pkg/models/measurements"
+	"github.com/glebarez/sqlite"
+	"github.com/gofrs/uuid/v5"
+	"github.com/sirupsen/logrus"
+	"github.com/stretchr/testify/require"
+	"gorm.io/gorm"
+)
+
+func newMetricsTestRepository(t *testing.T) *scrutinyRepository {
+	t.Helper()
+
+	database, err := gorm.Open(sqlite.Open(t.TempDir()+"/scrutiny.db"), &gorm.Config{})
+	require.NoError(t, err)
+	require.NoError(t, database.AutoMigrate(&models.SmartMetric{}, &models.TempMetric{}))
+
+	return &scrutinyRepository{
+		logger:     logrus.New(),
+		gormClient: database,
+	}
+}
+
+func TestSmartMetricRoundTrip(t *testing.T) {
+	repository := newMetricsTestRepository(t)
+	ctx := context.Background()
+	scrutinyUUID := uuid.Must(uuid.NewV4())
+	now := time.Now().Truncate(time.Second)
+
+	for offset := 0; offset < 3; offset++ {
+		smart := measurements.Smart{
+			Date:           now.Add(-time.Duration(offset) * time.Hour),
+			ScrutinyUUID:   scrutinyUUID,
+			DeviceProtocol: pkg.DeviceProtocolAta,
+			Temp:           int64(30 + offset),
+			PowerOnHours:   100,
+			PowerCycleCount: 2,
+			Attributes:     map[string]measurements.SmartAttribute{},
+		}
+		require.NoError(t, repository.saveSmartMeasurement(ctx, smart))
+	}
+
+	history, err := repository.GetSmartAttributeHistory(ctx, scrutinyUUID, DURATION_KEY_WEEK, 0, 0, 0, nil)
+	require.NoError(t, err)
+	require.Len(t, history, 3)
+	require.True(t, now.Equal(history[0].Date))
+	require.Equal(t, int64(30), history[0].Temp)
+	require.True(t, now.Add(-2*time.Hour).Equal(history[2].Date))
+}
+
+func TestAggregateSmartMetricRowsUsesLastEntryPerWindow(t *testing.T) {
+	now := time.Now().UTC().Truncate(time.Hour).Add(30 * time.Minute)
+	rows := []models.SmartMetric{
+		{Date: now},
+		{Date: now.Add(-25 * time.Minute)},
+		{Date: now.Add(-2 * time.Hour)},
+	}
+
+	aggregated := aggregateSmartMetricRows(rows, time.Hour)
+	require.Len(t, aggregated, 2)
+	require.True(t, now.Equal(aggregated[0].Date))
+	require.True(t, now.Add(-2*time.Hour).Equal(aggregated[1].Date))
+}
+
+func TestDecodeMetricFieldsPreservesFailureRateFloat(t *testing.T) {
+	fields, err := decodeMetricFields(`{"temp":25,"attr.5.failure_rate":0}`)
+	require.NoError(t, err)
+	require.IsType(t, int64(0), fields["temp"])
+	require.IsType(t, float64(0), fields["attr.5.failure_rate"])
+}
