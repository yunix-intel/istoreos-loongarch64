#!/bin/sh /etc/rc.common
# tailscaled：只起 daemon。首次使用 ssh 进去跑 `tailscale up` 扫码登录。
# 注意：纯 mesh 用，别开 exit node（会和 Mihomo TUN 抢默认路由）。
START=95
STOP=10
USE_PROCD=1

start_service() {
	mkdir -p /var/lib/tailscale
	procd_open_instance tailscaled
	procd_set_param command /usr/bin/tailscaled
	procd_append_param command --state=/var/lib/tailscale/tailscaled.state
	procd_append_param command --socket=/var/run/tailscale/tailscaled.sock
	procd_set_param respawn
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}
