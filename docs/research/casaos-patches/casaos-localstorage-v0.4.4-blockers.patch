--- a/build/sysroot/usr/share/casaos/shell/local-storage-helper.sh
+++ b/build/sysroot/usr/share/casaos/shell/local-storage-helper.sh
@@ -10,10 +10,47 @@ GetPlugInDisk() {
   fdisk -l | grep 'Disk' | grep 'sd' | awk -F , '{print substr($1,11,3)}'
 }
 
+
+# Device transport whitelist. Mirrors service.IsDiskSupported(): sata, nvme,
+# spi, sas, ata, virtio, Hyper-V and mmc. loop/nbd/dm/mapper are rejected.
+IsDiskAllowed() {
+  DEV="$1"
+  [ -n "$DEV" ] || return 1
+  [ -b "$DEV" ] || return 1
+  case "$DEV" in
+    /dev/loop*|/dev/nbd*|/dev/dm-*|/dev/mapper/*) return 1 ;;
+  esac
+  TYPE=$(lsblk -dn -o TYPE "$DEV" 2>/dev/null | tr -d '[:space:]')
+  TRAN=$(lsblk -dn -o TRAN "$DEV" 2>/dev/null | tr -d '[:space:]')
+  SUBS=$(lsblk -dn -o SUBSYSTEMS "$DEV" 2>/dev/null | tr -d '[:space:]')
+  if [ "$TYPE" = "part" ] && [ -z "$TRAN" ]; then
+    PK=$(lsblk -dn -o PKNAME "$DEV" 2>/dev/null | tr -d '[:space:]')
+    [ -n "$PK" ] || return 1
+    TRAN=$(lsblk -dn -o TRAN "/dev/$PK" 2>/dev/null | tr -d '[:space:]')
+    SUBS=$(lsblk -dn -o SUBSYSTEMS "/dev/$PK" 2>/dev/null | tr -d '[:space:]')
+    TYPE=$(lsblk -dn -o TYPE "/dev/$PK" 2>/dev/null | tr -d '[:space:]')
+  fi
+  case "$TRAN" in
+    sata|nvme|spi|sas|ata) return 0 ;;
+  esac
+  case "$SUBS" in
+    *virtio*|*block:scsi:vmbus:acpi*|*block:mmc:mmc_host:pci*) return 0 ;;
+  esac
+  return 1
+}
+
+RequireSupportedDisk() {
+  if ! IsDiskAllowed "$1"; then
+    echo "Refusing unsupported or non-whitelisted device: $1" >&2
+    return 1
+  fi
+}
+
 #格式化fat32磁盘
 #param 需要格式化的目录 /dev/sda1
 #param 格式
 FormatDisk() {
+  RequireSupportedDisk "$1" || return 1
   if [ "$2" == "fat32" ]; then
     mkfs.vfat -F 32 $1
   elif [ "$2" == "ntfs" ]; then
@@ -44,6 +81,7 @@ UMountPointAndRemoveDir() {
 #param 路径   /dev/sdb
 #param 要挂载的目录
 AddPartition() {
+  RequireSupportedDisk "$1" || return 1
   set -e
 
   parted -s $1 mklabel gpt
@@ -63,6 +101,7 @@ GetDiskType() {
 # $1=sda1
 # $2=volume{1}
 do_mount() {
+  RequireSupportedDisk "$1" || return 1
   set -e
 
   DEVBASE=$1
