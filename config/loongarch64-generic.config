# loongarch64/generic 基线配置（iStore 版）——保持最小化，只写目标与所需包，
# 其余交 defconfig 展开。手写 8000 行 config 会在上游浮动时被静默丢符号，
# 教训见 docs/BUILDLOG.md（CI 连红）。
CONFIG_TARGET_loongarch64=y
CONFIG_TARGET_loongarch64_generic=y
CONFIG_TARGET_loongarch64_generic_DEVICE_generic=y
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# LuCI 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# iStore 商店
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y

# 组网与代理
CONFIG_PACKAGE_tailscale=y
CONFIG_PACKAGE_easytier=y
CONFIG_PACKAGE_luci-app-openclash=y
CONFIG_PACKAGE_kmod-tun=y

# dnsmasq 二选一（留 -full；两个都开会在 package/install 报 file clash，
# la4 构建实测。plain 版会被默认 profile 带回来，必须显式关）。
# CONFIG_PACKAGE_dnsmasq is not set
CONFIG_PACKAGE_dnsmasq-full=y

# v3 第一批
CONFIG_PACKAGE_ddns-go=y
CONFIG_PACKAGE_filebrowser=y
CONFIG_PACKAGE_webdav=y
CONFIG_PACKAGE_rclone=y
CONFIG_PACKAGE_cpulimit-ng=y
CONFIG_PACKAGE_msd_lite=y
CONFIG_PACKAGE_vsftpd-alt=y
CONFIG_PACKAGE_xray-core=y
CONFIG_PACKAGE_qbittorrent-ee=y

# v3 第二批
CONFIG_PACKAGE_alist=y
CONFIG_PACKAGE_baidupcs-go=y
CONFIG_PACKAGE_homebox=y
CONFIG_PACKAGE_sunpanel=y
CONFIG_PACKAGE_lucky=y
CONFIG_PACKAGE_vlmcsd=y
CONFIG_PACKAGE_rtp2httpd=y
CONFIG_PACKAGE_openlist=y

# v3 第三批
CONFIG_PACKAGE_aliyundrive-webdav=y
CONFIG_PACKAGE_51ddns-agent=y
CONFIG_PACKAGE_quectel-CM-5G=y
CONFIG_PACKAGE_floatip=y

# 2026-10-18 容器真机验证补件（公版 la3 同病，la4 修）：
# opkg-archconf 补运行时 arch 声明；iptables-nft 给 tailscale 的 netfilter 调用；
# luci-compat 给 luci-app-openclash（旧 cbi 接口在 24.10 会炸菜单，容器里实测）。
CONFIG_PACKAGE_opkg-archconf=y
CONFIG_PACKAGE_iptables-nft=y
CONFIG_PACKAGE_luci-compat=y
