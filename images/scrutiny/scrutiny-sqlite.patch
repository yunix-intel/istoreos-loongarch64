+++ b/webapp/backend/pkg/models/metrics.go
@@ -0,0 +1,32 @@
+package models
+
+import "time"
+
+// SmartMetric is a single SMART scan result stored in SQLite.
+// Fields contains the flattened SMART field map (including attr.* keys)
+// serialized as JSON. Keeping the flattened representation means the
+// existing measurements.Smart decoding path can be reused unchanged.
+type SmartMetric struct {
+	ID             uint      `gorm:"primaryKey" json:"-"`
+	ScrutinyUUID   string    `gorm:"type:text;uniqueIndex:idx_smart_metrics_uuid_date,priority:1" json:"scrutiny_uuid"`
+	Date           time.Time `gorm:"uniqueIndex:idx_smart_metrics_uuid_date,priority:2;index:idx_smart_metrics_date" json:"date"`
+	DeviceProtocol string    `gorm:"type:text" json:"device_protocol"`
+	Fields         string    `gorm:"type:text" json:"fields"`
+}
+
+func (SmartMetric) TableName() string {
+	return "smart_metrics"
+}
+
+// TempMetric is a single temperature sample (current value or an entry from
+// the ATA SCT temperature history table).
+type TempMetric struct {
+	ID           uint      `gorm:"primaryKey" json:"-"`
+	ScrutinyUUID string    `gorm:"type:text;uniqueIndex:idx_temp_metrics_uuid_date,priority:1" json:"scrutiny_uuid"`
+	Date         time.Time `gorm:"uniqueIndex:idx_temp_metrics_uuid_date,priority:2;index:idx_temp_metrics_date" json:"date"`
+	Temp         int64     `json:"temp"`
+}
+
+func (TempMetric) TableName() string {
+	return "temp_metrics"
+}
