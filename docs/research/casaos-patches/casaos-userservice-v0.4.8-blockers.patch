 	url2 "net/url"
 	"os"
@@ -39,9 +40,45 @@ import (
 	"github.com/gin-gonic/gin"
 )
 
+func isLoopbackHost(hostPort string) bool {
+	host := hostPort
+	if h, _, err := net.SplitHostPort(hostPort); err == nil {
+		host = h
+	}
+	ip := net.ParseIP(strings.Trim(host, "[]"))
+	return ip != nil && ip.IsLoopback()
+}
+
+// requestIsLoopback accepts direct loopback connections and gateway-proxied
+// requests whose original client (X-Forwarded-For / X-Real-IP) is loopback.
+// A LAN client cannot spoof its way in because RemoteAddr is also checked.
+func requestIsLoopback(c *gin.Context) bool {
+	if !isLoopbackHost(c.Request.RemoteAddr) {
+		return false
+	}
+	for _, header := range []string{"X-Forwarded-For", "X-Real-IP"} {
+		value := c.GetHeader(header)
+		if value == "" {
+			continue
+		}
+		first := strings.TrimSpace(strings.Split(value, ",")[0])
+		if !isLoopbackHost(first) {
+			return false
+		}
+	}
+	return true
+}
+
