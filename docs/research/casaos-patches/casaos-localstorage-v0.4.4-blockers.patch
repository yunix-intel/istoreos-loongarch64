+	}
+}
+
+// confirmUserPassword verifies the password against the logged-in user by
+// calling UserService's login endpoint. The JWT itself does not carry a
+// password hash, so this is the only safe way to re-authenticate.
+func confirmUserPassword(c *gin.Context, password string) bool {
+	if password == "" {
+		return false
+	}
+	token := strings.TrimSpace(c.GetHeader("Authorization"))
+	token = strings.TrimPrefix(token, "Bearer ")
+	claims, err := jwt.ParseToken(token, func() (*ecdsa.PublicKey, error) {
+		return external.GetPublicKey(config.CommonInfo.RuntimePath)
+	})
+	if err != nil || claims == nil || claims.Username == "" {
+		return false
+	}
+	addressBytes, err := os.ReadFile(filepath.Join(config.CommonInfo.RuntimePath, external.UserServiceAddressFilename))
+	if err != nil {
+		logger.Error("error when reading user service address", zap.Error(err))
+		return false
+	}
+	address := strings.TrimRight(strings.TrimSpace(string(addressBytes)), "/")
+	body, err := json.Marshal(map[string]string{"username": claims.Username, "password": password})
+	if err != nil {
+		return false
+	}
+	client := &http.Client{Timeout: 5 * time.Second}
+	resp, err := client.Post(address+"/v1/users/login", "application/json", bytes.NewReader(body))
+	if err != nil {
+		logger.Error("error when verifying user password", zap.Error(err))
+		return false
+	}
+	defer resp.Body.Close()
+	if resp.StatusCode != http.StatusOK {
+		return false
+	}
+	var result struct {
+		Success int `json:"success"`
+	}
+	if err := json.NewDecoder(resp.Body).Decode(&result); err != nil {
+		return false
+	}
+	return result.Success == 200
+}
