# loongarch64/generic 基线配置（iStore 版）
# 用法：拷为源码树 .config 后 make defconfig
# طلب：TARGET=loongarch64，内核 6.6（istoreos 树自带 target/linux/loongarch64/config-6.6）

CONFIG_TARGET_loongarch64=y
CONFIG_TARGET_loongarch64_generic=y
CONFIG_TARGET_loongarch64_generic_Default=y

# LuCI 中文
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-i18n-base-zh-cn=y

# iStore 商店（源：linkease/istore feed + nas-packages-luci feed，见 docs/BUILDLOG）
CONFIG_PACKAGE_luci-app-store=y
CONFIG_PACKAGE_taskd=y
CONFIG_PACKAGE_luci-lib-taskd=y
CONFIG_PACKAGE_luci-app-quickstart=y
CONFIG_PACKAGE_luci-app-istorex=y

# 软路由刚需
CONFIG_PACKAGE_kmod-tun=y
