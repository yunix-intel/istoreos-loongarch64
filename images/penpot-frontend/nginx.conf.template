worker_processes auto;
pid /tmp/nginx.pid;
error_log /dev/stderr warn;

events {
    worker_connections 4096;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log /dev/stdout;
    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    server_tokens off;

    client_body_temp_path /tmp/client_temp;
    proxy_temp_path /tmp/proxy_temp_path;
    fastcgi_temp_path /tmp/fastcgi_temp;
    uwsgi_temp_path /tmp/uwsgi_temp;
    scgi_temp_path /tmp/scgi_temp;

    resolver 127.0.0.11 valid=30s ipv6=off;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_static on;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/javascript application/javascript application/json application/transit+json image/svg+xml application/wasm;

    proxy_connect_timeout 300s;
    proxy_send_timeout 300s;
    proxy_read_timeout 300s;

    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    server {
        listen 8080;
        server_name _;

        client_max_body_size ${PENPOT_HTTP_SERVER_MAX_BODY_SIZE};
        charset utf-8;
        root /var/www/app;
        index index.html;
        etag off;
        proxy_hide_header X-Powered-By;

        set $backend ${PENPOT_BACKEND_URI};
        set $exporter ${PENPOT_EXPORTER_URI};

        location /api/export {
            proxy_set_header Host $proxy_host;
            proxy_pass $exporter$request_uri;
        }

        location /api {
            proxy_set_header Host $proxy_host;
            proxy_pass $backend$request_uri;
            proxy_buffering off;
        }

        location /assets {
            proxy_set_header Host $proxy_host;
            proxy_pass $backend$request_uri;
        }

        location /readyz {
            access_log off;
            proxy_set_header Host $proxy_host;
            proxy_pass $backend$request_uri;
        }

        location /ws/notifications {
            proxy_http_version 1.1;
            proxy_set_header Host $proxy_host;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_pass $backend$request_uri;
        }

        location /plugins {
            alias /var/www/app/plugins;
        }

        location = /js/config.js {
            add_header Cache-Control "no-store, no-cache, max-age=0" always;
        }

        location ~* \.(js|css|jpg|png|svg|gif|ttf|woff|woff2|wasm|map)$ {
            add_header Cache-Control "public, max-age=604800" always;
        }

        location / {
            add_header Cache-Control "no-store, no-cache, max-age=0" always;
            try_files $uri /index.html$is_args$args /index.html =404;
        }
    }
}
