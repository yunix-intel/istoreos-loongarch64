{
  "schema": 1,
  "note": "Curated runtime facts for the 115 LoongArch64 app-meta packages. Values not listed here are derived from images/<id>/Dockerfile* and store/casaos/port-plan.json. Placeholders: ${PUBLIC_URL}, ${HOST_IP}, ${PRIMARY_PORT}, ${APP_ID}, ${SECRET:name[:len]}. Never put real credentials in this file.",
  "sidecar_templates": {
    "postgres": {
      "image": "yunixintel/postgres:24.10-la5",
      "shm_size": "",
      "env": [
        {
          "key": "POSTGRES_USER",
          "value": "${DB_USER}",
          "required": true
        },
        {
          "key": "POSTGRES_PASSWORD",
          "value": "${SECRET:pg_password}",
          "required": true
        },
        {
          "key": "POSTGRES_DB",
          "value": "${DB_NAME}",
          "required": true
        }
      ],
      "volumes": [
        {
          "name": "pgdata",
          "host": "/srv/${BASE}/pgdata",
          "container": "/var/lib/postgresql/data",
          "mode": "rw",
          "owner": "26:26"
        }
      ],
      "health": {
        "cmd": "pg_isready -U ${DB_USER} -d ${DB_NAME}",
        "interval": "5s",
        "timeout": "3s",
        "retries": 30
      }
    },
    "mariadb": {
      "image": "yunixintel/mariadb:24.10-la5",
      "shm_size": "",
      "env": [
        {
          "key": "MYSQL_ROOT_PASSWORD",
          "value": "${SECRET:mysql_root_password}",
          "required": true
        },
        {
          "key": "MYSQL_DATABASE",
          "value": "${DB_NAME}",
          "required": true
        },
        {
          "key": "MYSQL_USER",
          "value": "${DB_USER}",
          "required": true
        },
        {
          "key": "MYSQL_PASSWORD",
          "value": "${SECRET:mysql_password}",
          "required": true
        }
      ],
      "volumes": [
        {
          "name": "mysqldata",
          "host": "/srv/${BASE}/mysqldata",
          "container": "/var/lib/mysql",
          "mode": "rw",
          "owner": "27:27"
        }
      ],
      "health": {
        "cmd": "mysqladmin ping -h 127.0.0.1 --silent",
        "interval": "5s",
        "timeout": "3s",
        "retries": 40
      }
    },
    "redis": {
      "image": "yunixintel/redis:24.10-la5",
      "shm_size": "",
      "env": [
        {
          "key": "REDIS_PASSWORD",
          "value": "${SECRET:redis_password}",
          "required": true
        }
      ],
      "volumes": [
        {
          "name": "redisdata",
          "host": "/srv/${BASE}/redisdata",
          "container": "/data",
          "mode": "rw",
          "owner": "998:996"
        }
      ],
      "health": {
        "cmd": "redis-cli -a \"$REDIS_PASSWORD\" ping",
        "interval": "5s",
        "timeout": "3s",
        "retries": 20
      }
    },
    "minio": {
      "image": "yunixintel/minio:24.10-la5",
      "shm_size": "",
      "env": [
        {
          "key": "MINIO_ROOT_USER",
          "value": "istoreadmin",
          "required": true
        },
        {
          "key": "MINIO_ROOT_PASSWORD",
          "value": "${SECRET:minio_password}",
          "required": true
        }
      ],
      "volumes": [
        {
          "name": "miniodata",
          "host": "/srv/${BASE}/miniodata",
          "container": "/data",
          "mode": "rw",
          "owner": "1000:1000"
        }
      ],
      "health": {
        "cmd": "",
        "interval": "",
        "timeout": "",
        "retries": 15
      }
    },
    "lbrowser": {
      "image": "yunixintel/lbrowser-runtime:3.4.2293.2",
      "shm_size": "1g",
      "command": [
        "serve"
      ],
      "env": [],
      "volumes": [
        {
          "name": "lbrowser",
          "host": "/opt/apps/lbrowser",
          "container": "/opt/apps/lbrowser",
          "mode": "ro",
          "owner": ""
        }
      ],
      "health": {
        "cmd": "",
        "interval": "",
        "timeout": "",
        "retries": 5
      },
      "preload": false
    }
  },
  "apps": {
    "jellyfin": {
      "env": [
        {
          "key": "JELLYFIN_PublishedServerUrl",
          "value": "${PUBLIC_URL}",
          "required": false
        }
      ],
      "review": {
        "notes": [
          "媒体目录 /media 默认映射到 /mnt/media；硬件转码未验证。"
        ]
      }
    },
    "navidrome": {
      "primary_port": 4533,
      "env": [
        {
          "key": "ND_MUSICFOLDER",
          "value": "/music",
          "required": false
        },
        {
          "key": "ND_DATAFOLDER",
          "value": "/data",
          "required": false
        }
      ],
      "review": {
        "notes": [
          "音乐目录 /music 默认映射到 /mnt/music。"
        ]
      }
    },
    "vaultwarden": {
      "ports": [
        {
          "name": "http",
          "container": 8443,
          "proto": "tcp",
          "primary": true
        }
      ],
      "volumes": [
        {
          "container": "/data",
          "name": "data",
          "primary": true
        }
      ],
      "env": [
        {
          "key": "DOMAIN",
          "value": "${PUBLIC_URL}",
          "required": false
        }
      ],
      "review": {
        "notes": [
          "未设置 ADMIN_TOKEN；Web 注册默认开启，公网部署前应关闭注册并加 TLS 反代。"
        ]
      }
    },
    "mihomo": {
      "host_network": true,
      "ports": [
        {
          "name": "api",
          "container": 9090,
          "proto": "tcp",
          "primary": true
        }
      ],
      "volumes": [
        {
          "container": "/etc/mihomo",
          "name": "config",
          "primary": true,
          "type": "dir"
        }
      ],
      "review": {
        "manual": [
          "把可用的 config.yaml 放入 /srv/mihomo/config 后重启"
        ],
        "notes": [
          "host 网络；配置含订阅/节点密钥，未随包提供。无 Web UI，9090 为外部控制器默认端口。"
        ]
      }
    },
    "easytier": {
      "host_network": true,
      "ports": [],
      "volumes": [
        {
          "container": "/etc/easytier",
          "name": "config",
          "primary": true,
          "type": "dir"
        }
      ],
      "review": {
        "manual": [
          "把 network.toml 放入 /srv/easytier/config 后重启"
        ],
        "notes": [
          "host 网络；无 Web UI；network.toml 含网络密钥，未随包提供。"
        ]
      }
    },
    "adguardhome": {
      "host_network": true,
      "ports": [
        {
          "name": "http",
          "container": 3000,
          "proto": "tcp",
          "primary": true
        },
        {
          "name": "dns",
          "container": 53,
          "proto": "tcp",
          "primary": false
        },
        {
          "name": "dns-udp",
          "container": 53,
          "proto": "udp",
          "primary": false
        }
      ],
      "volumes": [
        {
          "container": "/opt/adguardhome/work",
          "name": "work",
          "primary": true
        },
        {
          "container": "/opt/adguardhome/conf",
          "name": "conf",
          "primary": false
        }
      ],
      "review": {
        "manual": [
          "确认宿主 53 端口未被 dnsmasq 占用（或先停用 dnsmasq）"
        ],
        "notes": [
          "host 网络；53 端口需避让宿主 DNS。"
        ]
      },
      "needs_config": true
    },
    "syncthing": {
      "primary_port": 8384,
      "fixed_ports": [
        22000,
        21027
      ],
      "review": {
        "notes": [
          "22000/tcp 与 21027/udp 使用固定宿主端口；21027/udp 用于本地发现。"
        ]
      }
    },
    "memos": {
      "ports": [
        {
          "name": "http",
          "container": 5230,
          "proto": "tcp",
          "primary": true
        }
      ],
      "volumes": [
        {
          "container": "/opt/memos/data",
          "name": "data",
          "primary": true
        }
      ]
    },
    "gogs": {
      "primary_port": 3000,
      "review": {
        "notes": [
          "SSH 22 映射到自动分配的高位宿主端口；可在 /etc/config/gogs 中改 host_port，SSH 端口需手工调整。"
        ]
      }
    },
    "filebrowser": {
      "volumes": [
        {
          "container": "/srv",
          "name": "files",
          "host": "/mnt/files",
          "primary": true
        },
        {
          "container": "/database",
          "name": "database",
          "primary": false
        }
      ],
      "review": {
        "notes": [
          "/srv 映射到 /mnt/files；/database 保存 filebrowser.db。"
        ]
      }
    },
    "qbittorrent-ee": {
      "primary_port": 8080,
      "review": {
        "notes": [
          "Web UI 的 Host header 必须匹配访问地址；下载目录 /downloads 映射到 /mnt/downloads。"
        ]
      }
    },
    "it-tools": {
      "review": {
        "notes": [
          "纯静态工具集，无持久化。"
        ]
      }
    },
    "excalidraw": {
      "review": {
        "notes": [
          "静态前端，无持久化；画布数据保存在浏览器。"
        ]
      }
    },
    "kopia": {
      "volumes": [
        {
          "container": "/app/config",
          "name": "config",
          "primary": true
        },
        {
          "container": "/repository",
          "name": "repository",
          "primary": false
        }
      ],
      "review": {
        "manual": [
          "在 Web UI 中创建仓库并设置 Basic 认证"
        ],
        "notes": [
          "仓库目录 /repository 映射到 /srv/kopia/repository。"
        ]
      }
    },
    "linkding": {
      "env": [
        {
          "key": "UWSGI_MAX_FD",
          "value": "4096",
          "required": false
        }
      ],
      "review": {
        "notes": [
          "SQLite；首次启动后在 Web 创建管理员。"
        ]
      }
    },
    "heimdall": {
      "primary_port": 8080
    },
    "nextcloud": {
      "ports": [
        {
          "name": "http",
          "container": 8080,
          "proto": "tcp",
          "primary": true
        }
      ],
      "review": {
        "notes": [
          "默认 SQLite（测试/家用）；生产建议外接 MariaDB。首次启动进入安装向导。"
        ]
      }
    },
    "typecho": {
      "volumes": [
        {
          "container": "/var/www/html",
          "name": "html",
          "primary": true
        },
        {
          "container": "/data",
          "name": "data",
          "primary": false
        }
      ],
      "review": {
        "manual": [
          "在 Web 安装向导中填写数据库；默认 SQLite 可用"
        ],
        "notes": [
          "站点根目录与数据库都在持久卷内。"
        ]
      }
    },
    "wallabag": {
      "ports": [
        {
          "name": "http",
          "container": 8080,
          "proto": "tcp",
          "primary": true
        }
      ],
      "env": [
        {
          "key": "SYMFONY__ENV__DOMAIN_NAME",
          "value": "${PUBLIC_URL}",
          "required": false
        }
      ],
      "review": {
        "manual": [
          "首次安装需执行镜像内 CLI 或按镜像文档创建管理员"
        ],
        "notes": [
          "SQLite；首次启动后按 wallabag 文档完成安装。"
        ]
      }
    },
    "drawio": {
      "review": {
        "notes": [
          "静态前端，无持久化。"
        ]
      }
    },
    "jackett": {
      "review": {
        "notes": [
          "/config 与 /downloads 持久化；首次在 Web 配置索引器。"
        ]
      }
    },
    "xteve": {
      "review": {
        "notes": [
          "/config 与 /data 持久化；首次在 Web 配置 M3U/XMLTV。"
        ]
      }
    },
    "one-api": {
      "review": {
        "notes": [
          "SQLite；首次登录 root/123456，应立即改密。"
        ]
      }
    },
    "code-server": {
      "ports": [
        {
          "name": "http",
          "container": 8443,
          "proto": "tcp",
          "primary": true
        }
      ],
      "volumes": [
        {
          "container": "/home/coder",
          "name": "home",
          "primary": true
        }
      ],
      "env": [
        {
          "key": "PASSWORD",
          "value": "${SECRET:code_password}",
          "required": true
        }
      ],
      "review": {
        "notes": [
          "密码由安装器生成并保存在 secrets 文件；也可改 /etc/config/code-server 的 env_file。"
        ]
      }
    },
    "dpanel": {
      "docker_sock": true,
      "review": {
        "notes": [
          "需要 Docker socket；/dpanel 持久化。"
        ]
      }
    },
    "shiori": {
      "env": [
        {
          "key": "SHIORI_HTTP_SECRET_KEY",
          "value": "${SECRET:http_secret}",
          "required": false
        }
      ],
      "review": {
        "notes": [
          "SQLite；建议保留自动生成的 HTTP secret。"
        ]
      }
    },
    "jellyseerr": {
      "review": {
        "notes": [
          "/app/config 持久化；首次进入设置向导连接 Jellyfin/Plex。"
        ]
      }
    },
    "audiobookshelf": {
      "review": {
        "notes": [
          "/audiobooks、/config、/metadata 持久化；有声书目录映射到 /mnt/audiobooks。"
        ]
      }
    },
    "calibre-web": {
      "review": {
        "notes": [
          "书库 /books 映射到 /mnt/books；/config 持久化。"
        ]
      }
    },
    "homarr": {
      "review": {
        "notes": [
          "内置 Redis 与 SQLite；/appdata 持久化。"
        ]
      }
    },
    "openwebui": {
      "env": [
        {
          "key": "WEBUI_URL",
          "value": "${PUBLIC_URL}",
          "required": false
        }
      ],
      "review": {
        "notes": [
          "轻量版，无 torch/RAG；/app/backend/data 持久化。"
        ]
      }
    },
    "kodexplorer": {
      "ports": [
        {
          "name": "http",
          "container": 8080,
          "proto": "tcp",
          "primary": true
        }
      ],
      "review": {
        "notes": [
          "PHP 应用；/var/www/html/data 持久化。"
        ]
      }
    },
    "homeassistant": {
      "host_network": true,
      "review": {
        "notes": [
          "host 网络以支持 mDNS/发现；/config 持久化。"
        ]
      }
    },
    "sonarr": {
      "review": {
        "notes": [
          "/config、/tv 持久化；/tv 映射到 /mnt/tv。"
        ]
      }
    },
    "radarr": {
      "review": {
        "notes": [
          "/config、/movies 持久化；/movies 映射到 /mnt/movies。"
        ]
      }
    },
    "tautulli": {
      "review": {
        "notes": [
          "/config 持久化；首次在 Web 配置 Plex。"
        ]
      }
    },
    "jellystat": {
      "sidecars": [
        {
          "template": "postgres",
          "name": "pg",
          "db_user": "jellystat",
          "db_name": "jellystat"
        }
      ],
      "review": {
        "notes": [
          "Jellystat 需要 PostgreSQL；安装器会启动 sidecar。首次在 Web 配置 Jellyfin。"
        ]
      }
    },
    "stirling-pdf": {
      "review": {
        "notes": [
          "/configs 持久化；无外部数据库。"
        ]
      }
    },
    "wizarr": {
      "review": {
        "notes": [
          "SQLite；/data 持久化；首次在 Web 完成设置。"
        ]
      }
    },
    "gitea": {
      "ports": [
        {
          "name": "http",
          "container": 3000,
          "proto": "tcp",
          "primary": true
        },
        {
          "name": "ssh",
          "container": 22,
          "proto": "tcp",
          "primary": false
        }
      ],
      "volumes": [
        {
          "container": "/data",
          "name": "data",
          "primary": true
        },
        {
          "container": "/etc/gitea",
          "name": "config",
          "primary": false
        }
      ],
      "review": {
        "notes": [
          "SQLite；入口脚本生成 app.ini；/data 与 /etc/gitea 持久化。"
        ]
      }
    },
    "miniflux": {
      "sidecars": [
        {
          "template": "postgres",
          "name": "pg",
          "db_user": "miniflux",
          "db_name": "miniflux"
        }
      ],
      "review": {
        "notes": [
          "仅支持 PostgreSQL；安装器启动 sidecar 并执行迁移。管理员 admin，密码在 secrets 文件。"
        ]
      }
    },
    "portainer": {
      "docker_sock": true,
      "review": {
        "notes": [
          "需要 Docker socket；/data 持久化；首次进入创建管理员。"
        ]
      }
    },
    "nginx-proxy-manager": {
      "ports": [
        {
          "name": "http",
          "container": 80,
          "proto": "tcp",
          "primary": false
        },
        {
          "name": "admin",
          "container": 81,
          "proto": "tcp",
          "host": 81,
          "primary": true
        },
        {
          "name": "https",
          "container": 443,
          "proto": "tcp",
          "primary": false
        }
      ],
      "volumes": [
        {
          "container": "/data",
          "name": "data",
          "primary": true
        },
        {
          "container": "/etc/letsencrypt",
          "name": "letsencrypt",
          "primary": false
        }
      ],
      "review": {
        "notes": [
          "管理端口 81 固定；80/443 默认自动分配高位端口（80/443 由 Caddy 持有）。首次登录 admin@example.com / changeme，应立即修改。"
        ]
      },
      "fixed_ports": [
        81
      ]
    },
    "firefly-iii": {
      "ports": [
        {
          "name": "http",
          "container": 8080,
          "proto": "tcp",
          "primary": true
        }
      ],
      "volumes": [
        {
          "container": "/var/www/html/storage",
          "name": "storage",
          "primary": true
        }
      ],
      "review": {
        "notes": [
          "SQLite 自动迁移/种子；首次进入安装向导。"
        ]
      }
    },
    "phpmyadmin": {
      "ports": [
        {
          "name": "http",
          "container": 8080,
          "proto": "tcp",
          "primary": true
        }
      ],
      "env": [
        {
          "key": "PMA_ARBITRARY",
          "value": "1",
          "required": false
        }
      ],
      "review": {
        "manual": [
          "在登录页填写外部 MySQL/MariaDB 主机、用户和密码"
        ],
        "notes": [
          "不内置数据库；PMA_ARBITRARY=1 允许连接任意服务器。"
        ]
      }
    },
    "freshrss": {
      "review": {
        "notes": [
          "SQLite；首次安装 admin/adminadmin，应立即改密。"
        ]
      }
    },
    "prowlarr": {
      "review": {
        "notes": [
          "/config 持久化；首次在 Web 配置索引器。"
        ]
      }
    },
    "bazarr": {
      "review": {
        "notes": [
          "/config、/movies、/tv 持久化；媒体目录映射到 /mnt。"
        ]
      }
    },
    "homer": {
      "volumes": [
        {
          "container": "/usr/share/nginx/html/assets/config.yml",
          "name": "config",
          "primary": true,
          "type": "file",
          "seed": "config.yml"
        }
      ],
      "review": {
        "notes": [
          "默认 config.yml 由安装器生成；编辑 /srv/homer/config.yml 后重启。"
        ]
      }
    },
    "paperless-ngx": {
      "env": [
        {
          "key": "PAPERLESS_ADMIN_USER",
          "value": "admin",
          "required": false
        },
        {
          "key": "PAPERLESS_ADMIN_PASSWORD",
          "value": "${SECRET:admin_password}",
          "required": true
        }
      ],
      "review": {
        "notes": [
          "单容器内含 redis/celery worker/beat/consumer；SQLite 默认；/data 持久化。"
        ]
      }
    },
    "dashy": {
      "volumes": [
        {
          "container": "/usr/share/nginx/html/conf.yml",
          "name": "config",
          "primary": true,
          "type": "file",
          "seed": "conf.yml"
        }
      ],
      "review": {
        "notes": [
          "默认 conf.yml 由安装器生成；编辑 /srv/dashy/conf.yml 后重启。"
        ]
      }
    },
    "watchtower": {
      "docker_sock": true,
      "command": [
        "--label-enable",
        "--interval",
        "3600"
      ],
      "review": {
        "notes": [
          "只更新带 com.centurylinklabs.watchtower.enable=true 的容器；--label-enable 避免误更新。"
        ]
      }
    },
    "changedetection": {
      "shm_size": "1g",
