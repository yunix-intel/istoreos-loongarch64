#!/usr/bin/env bash
set -Eeuo pipefail

PASSWORD_FILE="${PASSWORD_FILE:-/data/.htpasswd}"

if [ -z "${1:-}" ]; then
    echo "usage: create_user <username> [password]"
    exit 1
fi

if [ -z "${2:-}" ]; then
    htpasswd -B "$PASSWORD_FILE" "$1"
else
    htpasswd -B -b "$PASSWORD_FILE" "$1" "$2"
fi
