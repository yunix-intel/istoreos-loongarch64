diff --git a/webapp/backend/pkg/database/scrutiny_repository_metrics.go b/webapp/backend/pkg/database/scrutiny_repository_metrics.go
new file mode 100644
index 0000000..58ddfb0
--- /dev/null
+++ b/webapp/backend/pkg/database/scrutiny_repository_metrics.go
@@ -0,0 +1,205 @@
+package database
+
+import (
+	"context"
+	"encoding/json"
+	"fmt"
+	"sort"
+	"strings"
+	"time"
+
+	"github.com/analogj/scrutiny/webapp/backend/pkg/models"
+	"github.com/analogj/scrutiny/webapp/backend/pkg/models/measurements"
+	"github.com/gofrs/uuid/v5"
+	"gorm.io/gorm/clause"
+)
+
+// metricTimeRange returns the inclusive lower bound for a duration key.
+// The second return value is false for "forever", which has no lower bound.
+func (sr *scrutinyRepository) metricTimeRange(durationKey string) (time.Time, bool) {
+	now := time.Now()
+	switch durationKey {
+	case DURATION_KEY_DAY:
+		return now.Add(-24 * time.Hour), true
+	case DURATION_KEY_WEEK:
+		return now.Add(-7 * 24 * time.Hour), true
+	case DURATION_KEY_MONTH:
+		return now.AddDate(0, -1, 0), true
+	case DURATION_KEY_YEAR:
+		return now.AddDate(-1, 0, 0), true
+	case DURATION_KEY_FOREVER:
+		return time.Time{}, false
+	}
+	return now.Add(-7 * 24 * time.Hour), true
+}
+
+func (sr *scrutinyRepository) saveSmartMeasurement(ctx context.Context, sm measurements.Smart) error {
+	_, fields := sm.Flatten()
+	rawFields, err := json.Marshal(fields)
+	if err != nil {
+		return fmt.Errorf("failed to serialize SMART metrics: %w", err)
+	}
+
+	row := models.SmartMetric{
+		ScrutinyUUID:   sm.ScrutinyUUID.String(),
+		Date:           sm.Date,
+		DeviceProtocol: sm.DeviceProtocol,
+		Fields:         string(rawFields),
+	}
+
+	return sr.gormClient.WithContext(ctx).Clauses(clause.OnConflict{
+		Columns:   []clause.Column{{Name: "scrutiny_uuid"}, {Name: "date"}},
+		DoUpdates: clause.AssignmentColumns([]string{"device_protocol", "fields"}),
+	}).Create(&row).Error
+}
+
+func (sr *scrutinyRepository) saveTempMeasurements(ctx context.Context, scrutinyUUID uuid.UUID, points []measurements.SmartTemperature) error {
+	if len(points) == 0 {
+		return nil
+	}
+
+	rows := make([]models.TempMetric, 0, len(points))
+	for _, point := range points {
+		rows = append(rows, models.TempMetric{
+			ScrutinyUUID: scrutinyUUID.String(),
+			Date:         point.Date,
+			Temp:         point.Temp,
+		})
+	}
+
+	return sr.gormClient.WithContext(ctx).Clauses(clause.OnConflict{
+		Columns:   []clause.Column{{Name: "scrutiny_uuid"}, {Name: "date"}},
+		DoUpdates: clause.AssignmentColumns([]string{"temp"}),
+	}).CreateInBatches(&rows, 200).Error
+}
+
+func decodeMetricFields(raw string) (map[string]interface{}, error) {
+	decoder := json.NewDecoder(strings.NewReader(raw))
+	decoder.UseNumber()
+
+	fields := map[string]interface{}{}
+	if err := decoder.Decode(&fields); err != nil {
+		return nil, err
+	}
+
+	for key, value := range fields {
+		number, ok := value.(json.Number)
+		if !ok {
+			continue
+		}
+		// failure_rate is the only float64 field in the measurement models.
+		// JSON drops the fractional part for whole numbers (e.g. 0), so the
+		// generic Int64 path below would turn it into an int64 and make the
+		// existing Inflate implementations panic.
+		if strings.HasSuffix(key, ".failure_rate") {
+			if floatValue, err := number.Float64(); err == nil {
+				fields[key] = floatValue
+			}
+			continue
+		}
+		if integer, err := number.Int64(); err == nil {
+			fields[key] = integer
+		} else if floatValue, err := number.Float64(); err == nil {
+			fields[key] = floatValue
+		}
+	}
+	return fields, nil
+}
+
+func (sr *scrutinyRepository) smartFromMetricRow(row models.SmartMetric) (*measurements.Smart, error) {
+	fields, err := decodeMetricFields(row.Fields)
+	if err != nil {
+		return nil, fmt.Errorf("failed to decode SMART metrics for %s: %w", row.ScrutinyUUID, err)
+	}
+
+	values := map[string]interface{}{
+		"_time":           row.Date,
+		"scrutiny_uuid":   row.ScrutinyUUID,
+		"device_protocol": row.DeviceProtocol,
+	}
+	for key, value := range fields {
+		values[key] = value
+	}
+
+	return measurements.NewSmartFromInfluxDB(values)
+}
+
+func aggregateSmartMetricRows(rows []models.SmartMetric, window time.Duration) []models.SmartMetric {
+	if window <= 0 {
+		return rows
+	}
+
+	seen := map[int64]bool{}
+	aggregated := make([]models.SmartMetric, 0, len(rows))
+	for _, row := range rows { // rows arrive newest-first
+		bucket := row.Date.Truncate(window).Unix()
+		if seen[bucket] {
+			continue
+		}
+		seen[bucket] = true
+		aggregated = append(aggregated, row)
+	}
+	return aggregated
+}
+
+func pageSmartMetricRows(rows []models.SmartMetric, limit int, offset int) []models.SmartMetric {
+	if limit <= 0 {
+		return rows
+	}
+	if offset < 0 {
+		offset = 0
+	}
+	if offset >= len(rows) {
+		return []models.SmartMetric{}
+	}
+	end := offset + limit
+	if end > len(rows) {
+		end = len(rows)
+	}
+	return rows[offset:end]
+}
+
+func aggregateTempMetrics(rows []models.TempMetric, window time.Duration) map[uuid.UUID][]measurements.SmartTemperature {
+	type bucketKey struct {
+		uuid   string
+		bucket int64
+	}
+	type bucketValue struct {
+		date  time.Time
+		sum   int64
+		count int64
+	}
+
+	buckets := map[bucketKey]*bucketValue{}
+	for _, row := range rows {
+		key := bucketKey{uuid: row.ScrutinyUUID, bucket: row.Date.Truncate(window).Unix()}
+		value, ok := buckets[key]
+		if !ok {
+			value = &bucketValue{date: row.Date.Truncate(window)}
+			buckets[key] = value
+		}
+		value.sum += row.Temp
+		value.count++
+	}
+
+	history := map[uuid.UUID][]measurements.SmartTemperature{}
+	for key, value := range buckets {
+		parsedUUID, err := uuid.FromString(key.uuid)
+		if err != nil {
+			continue
+		}
+		temp := value.sum / value.count
+		history[parsedUUID] = append(history[parsedUUID], measurements.SmartTemperature{
+			Date: value.date,
+			Temp: temp,
+		})
+	}
+
+	for parsedUUID := range history {
+		sort.Slice(history[parsedUUID], func(i, j int) bool {
+			return history[parsedUUID][i].Date.Before(history[parsedUUID][j].Date)
+		})
+	}
+
+	return history
+}
