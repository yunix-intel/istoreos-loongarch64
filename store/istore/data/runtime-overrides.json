          "必须 MariaDB；安装器启动 sidecar；归档需 cron。"
        ]
      }
    },
    "woodpecker-server": {
      "network_group": "woodpecker",
      "env": [
        {
          "key": "WOODPECKER_HOST",
          "value": "${PUBLIC_URL}",
          "required": true
        },
        {
          "key": "WOODPECKER_OPEN",
          "value": "true",
          "required": false
        },
        {
          "key": "WOODPECKER_ADMIN",
          "value": "admin",
          "required": false
        },
        {
          "key": "WOODPECKER_GITEA",
          "value": "true",
          "required": false
        },
        {
          "key": "WOODPECKER_GITEA_URL",
          "value": "__UNSET__",
          "required": true
        },
        {
          "key": "WOODPECKER_GITEA_CLIENT",
          "value": "__UNSET__",
          "required": true
        },
        {
          "key": "WOODPECKER_GITEA_SECRET",
          "value": "__UNSET__",
          "required": true
        }
      ],
      "review": {
        "manual": [
          "在 /etc/istore-loong64/env/woodpecker-server.env 填写 Gitea URL/Client/Secret"
        ],
        "notes": [
          "必须配置 forge，否则启动失败；自动生成 agent/grpc secret。"
        ]
      }
    },
    "woodpecker-agent": {
      "network_group": "woodpecker",
      "requires_app": "woodpecker-server",
      "docker_sock": true,
      "env": [
        {
          "key": "WOODPECKER_SERVER",
          "value": "woodpecker-server:9000",
          "required": true
        },
        {
          "key": "WOODPECKER_AGENT_SECRET",
          "value": "__UNSET__",
          "required": true
        },
        {
          "key": "WOODPECKER_BACKEND",
          "value": "docker",
          "required": false
        },
        {
          "key": "WOODPECKER_MAX_WORKFLOWS",
          "value": "1",
          "required": false
        }
      ],
      "review": {
        "manual": [
          "从 woodpecker-server 的 /var/lib/woodpecker/agent-secret 读取 secret 并写入 env 文件"
        ],
        "notes": [
          "等同宿主 root；只接可信仓库。"
        ]
      }
    },
    "metube": {
      "env": [
        {
          "key": "PUID",
          "value": "1111",
          "required": false
        },
        {
          "key": "PGID",
          "value": "1111",
          "required": false
        }
      ],
      "review": {
        "notes": [
          "/downloads 映射到 /mnt/downloads。"
        ]
      }
    },
    "sabnzbd": {
      "review": {
        "notes": [
          "/config 与 /downloads 持久化；/downloads 映射到 /mnt/downloads。"
        ]
      }
    },
    "mediamtx": {
      "primary_port": 8888,
      "fixed_ports": [
        8554,
        1935,
        8889,
        8890,
        9997,
        8000,
        8001,
        8189
      ],
      "review": {
        "manual": [
          "在 mediamtx.yml 中配置摄像头/发布源"
        ],
        "notes": [
          "固定 RTP/RTSP/WebRTC 端口；无持久化。"
        ]
      }
    },
    "registry": {
      "ports": [
        {
          "name": "http",
          "container": 5000,
          "proto": "tcp",
          "host": 5000,
          "primary": true
        }
      ],
      "volumes": [
        {
          "container": "/var/lib/registry",
          "name": "data",
          "primary": true
        },
        {
          "container": "/auth",
          "name": "auth",
          "primary": false
        }
      ],
      "review": {
        "notes": [
          "首启生成 htpasswd；无 TLS；5000 固定端口。"
        ]
      }
    },
    "unpackerr": {
      "env": [
        {
          "key": "UN_SONARR_0_URL",
          "value": "__UNSET__",
          "required": true
        },
        {
          "key": "UN_SONARR_0_API_KEY",
          "value": "__UNSET__",
          "required": true
        },
        {
          "key": "UN_SONARR_0_PATHS_0",
          "value": "/downloads",
          "required": false
        }
      ],
      "review": {
        "manual": [
          "填写 Sonarr/Radarr URL 与 API key"
        ],
        "notes": [
          "无 UI；/config 与 /downloads 持久化。"
        ]
      }
    },
    "pocket-id": {
      "env": [
        {
          "key": "APP_URL",
          "value": "${PUBLIC_URL}",
          "required": true
        }
      ],
      "review": {
        "notes": [
          "首启生成加密密钥；/data 持久化。"
        ]
      }
    },
    "readeck": {
      "review": {
        "notes": [
          "CGO SQLite；/data 持久化；首启引导页。"
        ]
      }
    },
    "wg-easy": {
      "ports": [
        {
          "name": "wireguard",
          "container": 51820,
          "proto": "udp",
          "host": 51820,
          "primary": false
        },
        {
          "name": "http",
          "container": 51821,
          "proto": "tcp",
          "host": 51821,
          "primary": true
        }
      ],
      "cap_add": [
        "NET_ADMIN",
        "SYS_MODULE"
      ],
      "sysctls": [
        "net.ipv4.ip_forward=1",
        "net.ipv4.conf.all.src_valid_mark=1"
      ],
      "volumes": [
        {
          "container": "/etc/wireguard",
          "name": "wireguard",
          "primary": true
        },
        {
          "container": "/lib/modules",
          "name": "modules",
          "host": "/lib/modules",
          "primary": false,
          "mode": "ro"
        }
      ],
      "env": [
        {
          "key": "INSECURE",
          "value": "true",
          "required": false
        },
        {
          "key": "INIT_ENABLED",
          "value": "true",
          "required": false
        },
        {
          "key": "INIT_USERNAME",
          "value": "admin",
          "required": false
        },
        {
          "key": "INIT_PASSWORD",
          "value": "${SECRET:admin_password}",
          "required": true
        },
        {
          "key": "INIT_HOST",
          "value": "${HOST_IP}",
          "required": true
        },
        {
          "key": "INIT_PORT",
          "value": "51820",
          "required": false
        },
        {
          "key": "DISABLE_IPV6",
          "value": "true",
          "required": false
        }
      ],
      "review": {
        "manual": [
          "把 INIT_HOST 改成公网/VPN 可达地址；真实隧道未验"
        ],
        "notes": [
          "需要 NET_ADMIN/SYS_MODULE 与 sysctls；51820/udp + 51821/tcp 固定端口。"
        ]
      }
    },
    "komga": {
      "review": {
        "notes": [
          "/config 与 /data 持久化；/data 映射到 /mnt/comics；HEIF/JXL 封面不可用。"
        ]
      }
    },
    "karakeep": {
      "primary_port": 3000,
      "shm_size": "1g",
      "sidecars": [
        {
          "template": "lbrowser",
          "name": "lbrowser",
          "enabled_variants": [
            "public"
          ]
        }
      ],
      "review": {
        "notes": [
          "SQLite；/data 持久化；public 变体使用 LBrowser sidecar，private 变体内置浏览器；搜索需 Meilisearch。"
        ]
      },
      "needs_config": true
    },
    "linkwarden": {
      "primary_port": 3000,
      "shm_size": "1g",
      "sidecars": [
        {
          "template": "postgres",
          "name": "pg",
          "db_user": "linkwarden",
          "db_name": "linkwarden"
        },
        {
          "template": "lbrowser",
          "name": "lbrowser",
          "enabled_variants": [
            "public"
          ]
        }
      ],
      "review": {
        "notes": [
          "PostgreSQL sidecar 必需；public 变体使用 LBrowser sidecar，private 变体内置浏览器；/data/data 持久化。"
        ]
      },
      "needs_config": true
    },
    "joplin-server": {
      "sidecars": [
        {
          "template": "postgres",
          "name": "pg",
          "db_user": "joplin",
          "db_name": "joplin"
        }
      ],
      "review": {
        "notes": [
          "PostgreSQL sidecar；/data 持久化；管理员 admin@localhost，密码在 secrets 文件；无 sharp/sqlite-vec/PM2。"
        ]
      }
    }
  }
}
