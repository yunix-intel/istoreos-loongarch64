+// allowedStoragePaths returns the exact device paths that the server itself
+// considers supported: whitelisted disks and their partitions. Callers cannot
+// inject /dev/loop0, /dev/nbd0, /dev/mapper/* or symlinks, because those paths
+// are not present in this server-derived set.
+func allowedStoragePaths() map[string]struct{} {
+	allowed := make(map[string]struct{})
+	var add func(blk model1.LSBLKModel)
+	add = func(blk model1.LSBLKModel) {
+		if blk.Path != "" {
+			allowed[blk.Path] = struct{}{}
+		}
+		for _, child := range blk.Children {
+			// Only real partitions are addressable. Nested dm/lvm/crypt
+			// nodes stay out of the whitelist even under a supported disk.
+			if child.Type != "part" {
+				continue
+			}
+			add(child)
+		}
+	}
+	for _, blk := range service.MyService.Disk().LSBLK(false) {
+		if service.IsDiskSupported(blk) {
+			add(blk)
+		}
+	}
+	return allowed
+}
+
+func isStoragePathAllowed(path string) bool {
+	// Belt-and-suspenders: never allow loop/nbd/dm/mapper paths even if a
+	// future lsblk output or a nested child ever puts them in the set.
+	switch {
+	case strings.HasPrefix(path, "/dev/loop"),
+		strings.HasPrefix(path, "/dev/nbd"),
+		strings.HasPrefix(path, "/dev/dm-"),
+		strings.HasPrefix(path, "/dev/mapper/"):
+		return false
+	}
+	_, ok := allowedStoragePaths()[path]
+	return ok
+}
+
+// optionalBool accepts a JSON boolean or the strings "true"/"false".
+func optionalBool(v interface{}) (value bool, present bool, ok bool) {
+	if v == nil {
+		return false, false, true
+	}
+	switch t := v.(type) {
+	case bool:
+		return t, true, true
+	case string:
+		switch strings.ToLower(strings.TrimSpace(t)) {
+		case "true":
+			return true, true, true
+		case "false":
+			return false, true, true
+		}
+	}
+	return false, true, false
+}
+
+func requestString(v interface{}) string {
+	switch t := v.(type) {
+	case string:
+		return t
+	case nil:
+		return ""
+	default:
